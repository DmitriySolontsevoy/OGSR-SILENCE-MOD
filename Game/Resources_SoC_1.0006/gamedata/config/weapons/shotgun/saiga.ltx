snd_switch			= weapons\groza_switch, 1.0, 0.5
snd_click_last		= weapons\_general\shotgun_slide_click

snd_aim_start               = weapons\_general\shotgun_aim_start, 0.5
snd_aim_end                 = weapons\_general\shotgun_aim_end, 0.5

snd_grab = pickups\grab_gun

;params when silencer is attached 
;similar to corresponding params without prefix silencer_

;silencer_flame_particles	= weapons\generic_weapon01
silencer_smoke_particles 	= weapons\generic_shoot_00

silencer_hit_power 		= 0.580, 0.580, 0.580, 0.580
silencer_hit_impulse	 	= 64
silencer_fire_distance 		= 306
silencer_bullet_speed	 	= 290

silencer_light_color		= 0.6, 0.5, 0.3
silencer_light_range		= 0.01
silencer_light_var_color	= 0.05
silencer_light_var_range	= 0.5
silencer_light_time 		= 0.1


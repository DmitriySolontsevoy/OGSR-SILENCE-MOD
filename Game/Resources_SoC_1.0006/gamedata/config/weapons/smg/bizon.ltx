cam_dispersion_inc		= 0.12			; увеличениe cam_dispersion с каждым выстрелом
cam_dispertion_frac		= 0.4			; ствол будет подыматься на cam_dispersion*cam_dispertion_frac +- cam_dispersion*(1-cam_dispertion_frac)
cam_max_angle			= 6.0			; максимальный угол отдачи
cam_max_angle_horz		= 9.0			; (degree) maximum shot horizontal degree 
cam_step_angle_horz		= 0.4			; (degree) size of step camera moved in horizontal position while shooting

fire_dispersion_condition_factor= 5			; увеличение дисперсии в процентах при максимальном износе 
misfire_probability 		= 0.003			; вероятность осечки при максимальном износе 
misfire_condition_k		= 0.05
condition_shot_dec 		= 0.0002 		; увеличение износа при каждом выстреле

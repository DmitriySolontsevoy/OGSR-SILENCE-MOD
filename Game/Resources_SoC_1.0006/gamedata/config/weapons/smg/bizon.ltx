holder_fov_modifier		= 1.2 						; во сколько раз увеличивается eye_fov
;-----------------------------------------------------------------------------------

cartridge_bullet    = true

cost				= 2500
weapon_class			= assault_rifle

ammo_limit				= 210
ammo_current			= 210
